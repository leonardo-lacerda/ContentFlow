# =====================================================================
# Exemplo de .env de PRODUÇÃO para o Droplet (backend + orchestrator +
# postgres + redis + temporal, via docker-compose.yaml).
#
# Copie para `.env` no diretório da app no Droplet (DO_APP_DIR) e troque
# os valores. NUNCA comite o .env real (ele está no .gitignore).
# Substitua "seudominio.com" pelo seu domínio.
# =====================================================================

# --- Domínios (HTTPS obrigatório p/ o cookie de auth funcionar) ---
MAIN_URL="https://app.seudominio.com"
FRONTEND_URL="https://app.seudominio.com"
NEXT_PUBLIC_BACKEND_URL="https://api.seudominio.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"

# Domínio do backend, usado pelo Caddy (docker-compose.proxy.yaml)
API_DOMAIN="api.seudominio.com"

# --- Segurança ---
# Gere algo forte: openssl rand -hex 32
JWT_SECRET="TROQUE_POR_UMA_STRING_ALEATORIA_FORTE"
# Deixe NOT_SECURED comentado/vazio em produção: cookies Secure + SameSite=None.
# NOT_SECURED=""

# --- Banco / Redis / Temporal (rodam no próprio compose do Droplet) ---
DATABASE_URL="postgresql://contentflow-user:contentflow-password@contentflow-postgres:5432/contentflow-db-local"
REDIS_URL="redis://contentflow-redis:6379"
TEMPORAL_ADDRESS="temporal:7233"
DISABLE_TEMPORAL="false"

# --- App ---
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
API_LIMIT=30

# --- Storage ---
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads"

# --- IA (preencha com suas chaves reais) ---
OPENAI_API_KEY=""
KIEAI_API_KEY=""
CREATIVE_KIE_ENABLED="true"
BILLING_CREDITS_V2="true"
BILLING_PROVIDER="stripe"
BILLING_FREE_CREDITS="200"
BILLING_USD_BRL="5.50"
CREATIVE_KIE_BASE_URL="https://api.kie.ai"
CREATIVE_KIE_IMAGE_MODEL="gpt-image-1"
CREATIVE_KIE_VIDEO_MODEL="seedance-2.5"
CREATIVE_KIE_BROLL_MODEL="seedance-2.5"
CREATIVE_KIE_SEEDANCE_MODEL="seedance-2.5"
CREATIVE_KIE_SEEDANCE_RESOLUTION="720p"
CREATIVE_KIE_TTS_MODEL="elevenlabs/text-to-speech-multilingual-v2"
CREATIVE_KIE_TALKING_ACTOR_MODEL="kling/ai-avatar-standard"
CREATIVE_KIE_LIP_SYNC_MODEL="kling/ai-avatar-standard"
CREATIVE_KIE_ACTOR_REPLACEMENT_MODEL=""
CREATIVE_KIE_TRANSLATION_MODEL=""
CREATIVE_KIE_IMAGE_ENDPOINT="/api/v1/jobs/createTask"
CREATIVE_KIE_CALLBACK_URL=""
CREATIVE_KIE_WEBHOOK_SECRET=""
CREATIVE_KIE_POLL_INTERVAL_MS="5000"
CREATIVE_KIE_MAX_POLL_ATTEMPTS="180"
CREATIVE_KIE_IMAGE_CREDITS=""
CREATIVE_KIE_VIDEO_CREDITS=""
CREATIVE_KIE_BROLL_CREDITS=""
CREATIVE_KIE_TTS_CREDITS=""
CREATIVE_KIE_TALKING_ACTOR_CREDITS=""
CREATIVE_KIE_LIP_SYNC_CREDITS=""
CREATIVE_KIE_TRANSLATION_CREDITS=""
CREATIVE_ALLOW_UNSAFE_PRICING="false"
CREATIVE_IMAGE_PROVIDER=""
CREATIVE_VIDEO_PROVIDER=""
CREATIVE_BROLL_PROVIDER=""
CREATIVE_TTS_PROVIDER=""
CREATIVE_TRANSLATION_PROVIDER="contentflow"
CREATIVE_TALKING_ACTOR_PROVIDER=""
CREATIVE_LIP_SYNC_PROVIDER=""
CREATIVE_ACTOR_REPLACEMENT_PROVIDER=""
AI_GENERATE_OPENAI_API_KEY=""
AI_GENERATE_OPENAI_BASE_URL="https://api.openai.com"
AI_GENERATE_OPENAI_IMAGE_MODEL="gpt-image-2"

# --- Stripe (opcional) ---
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""
