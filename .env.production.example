# =====================================================================
# Exemplo de .env de PRODUÇÃO para o Droplet (backend + orchestrator +
# postgres + redis + temporal, via docker-compose.yaml).
#
# Copie para `.env` no diretório da app no Droplet (DO_APP_DIR) e troque
# os valores. NUNCA comite o .env real (ele está no .gitignore).
# Substitua "seudominio.com" pelo seu domínio.
# =====================================================================

# --- Domínios (HTTPS obrigatório p/ o cookie de auth funcionar) ---
MAIN_URL="https://app.seudominio.com"
FRONTEND_URL="https://app.seudominio.com"
NEXT_PUBLIC_BACKEND_URL="https://api.seudominio.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"

# Domínio do backend, usado pelo Caddy (docker-compose.proxy.yaml)
API_DOMAIN="api.seudominio.com"

# --- Segurança ---
# Gere algo forte: openssl rand -hex 32
JWT_SECRET="TROQUE_POR_UMA_STRING_ALEATORIA_FORTE"
# Deixe NOT_SECURED comentado/vazio em produção: cookies Secure + SameSite=None.
# NOT_SECURED=""

# --- Banco / Redis / Temporal (rodam no próprio compose do Droplet) ---
DATABASE_URL="postgresql://contentflow-user:contentflow-password@contentflow-postgres:5432/contentflow-db-local"
REDIS_URL="redis://contentflow-redis:6379"
TEMPORAL_ADDRESS="temporal:7233"
DISABLE_TEMPORAL="false"

# --- App ---
IS_GENERAL="true"
DISABLE_REGISTRATION="false"
API_LIMIT=30

# --- Storage ---
STORAGE_PROVIDER="local"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY="/uploads"

# --- IA (preencha com suas chaves reais) ---
OPENAI_API_KEY=""
AI_GENERATE_OPENAI_API_KEY=""
AI_GENERATE_OPENAI_BASE_URL="https://api.openai.com"
AI_GENERATE_OPENAI_IMAGE_MODEL="gpt-image-2"

# --- Stripe (opcional) ---
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_SIGNING_KEY=""
STRIPE_SIGNING_KEY_CONNECT=""
