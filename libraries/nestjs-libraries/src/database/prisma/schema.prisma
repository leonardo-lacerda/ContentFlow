  SELLER
}

enum State {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}

enum SubscriptionTier {
  STANDARD
  PRO
  TEAM
  ULTIMATE
}

enum Period {
  MONTHLY
  YEARLY
}

enum Provider {
  LOCAL
  GITHUB
  GOOGLE
  FARCASTER
  WALLET
  GENERIC
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

enum APPROVED_SUBMIT_FOR_ORDER {
  NO
  WAITING_CONFIRMATION
  YES
}

enum ShortLinkPreference {
  ASK
  YES
  NO
}

enum AnnouncementColor {
  INFO
  WARNING
  ERROR
}

model Announcement {
  id          String            @id @default(uuid())
  title       String
  description String
  color       AnnouncementColor @default(INFO)
  createdAt   DateTime          @default(now())
}

enum BrandProfileStatus {
  DRAFT
  ANALYZING
  NEEDS_REVIEW
  ACTIVE
  FAILED
}

model BrandProfile {
  id                 String              @id @default(uuid())
  organizationId     String
  name               String
  website            String?
  industry           String?
  status             BrandProfileStatus  @default(DRAFT)
  selected           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  organization       Organization        @relation(fields: [organizationId], references: [id])
  dnaSnapshots       BrandDnaSnapshot[]
  assets             BrandAsset[]
  contentIdeas       ContentIdea[]
  carouselProjects   CarouselProject[]
  editorialPlans     EditorialPlan[]
  learning           BrandLearning[]
  adCreatives        AdCreative[]
  emailCampaigns     EmailCampaign[]
  shortVideoProjects ShortVideoProject[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, selected])
}

model BrandDnaSnapshot {
  id             String       @id @default(uuid())
  brandProfileId String
  version        Int
  sourceType     String
  sourceUrl      String?
  summary        Json
  voice          Json
  audience       Json
  offer          Json
  visual         Json
  constraints    Json
  messaging         Json?
  contentGuidelines Json?
  confidence     Json?
  promptVersion  String
  model          String
  createdAt      DateTime     @default(now())
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@index([brandProfileId, version])
}

model BrandAsset {
  id             String       @id @default(uuid())
  brandProfileId String
  mediaId        String?
  type           String
  sourceUrl      String?
  metadata       Json?
  approved       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@index([type])
  @@index([deletedAt])
}

enum ContentIdeaStatus {
  NEW
  APPROVED
  REJECTED
  SAVED
  USED
  ARCHIVED
}

model ContentIdea {
  id                 String              @id @default(uuid())
  organizationId     String
  brandProfileId     String
  title              String
  hook               String
  goal               String
  angle              String
  templateSuggestion String?
  platformSuggestion String?
  score              Float?
  status             ContentIdeaStatus   @default(NEW)
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id])
  brandProfile       BrandProfile        @relation(fields: [brandProfileId], references: [id])
  carouselProject    CarouselProject?
  editorialSlots     EditorialSlot[]
  socialPosts        Post[]
  emailCampaigns     EmailCampaign[]
  shortVideoProjects ShortVideoProject[]
  AdCreative         AdCreative[]

  @@index([organizationId])
  @@index([brandProfileId])
  @@index([status])
  @@index([brandProfileId, status])
}

enum CarouselProjectStatus {
  DRAFT
  GENERATING
  REVIEW
  READY
  PUBLISHED
  FAILED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model CarouselProject {
  id                 String                @id @default(uuid())
  organizationId     String
  brandProfileId     String
  contentIdeaId      String?               @unique
  title              String
  caption            String?
  hashtags           String[]
  status             CarouselProjectStatus @default(DRAFT)
  slides             Json
  metadata           Json?
  approvalStatus     ApprovalStatus        @default(NONE)
  approvedBy         String?
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization          @relation(fields: [organizationId], references: [id])
  brandProfile       BrandProfile          @relation(fields: [brandProfileId], references: [id])
  contentIdea        ContentIdea?          @relation(fields: [contentIdeaId], references: [id])
  editorialSlots     EditorialSlot[]
  performances       CarouselPerformance[]
  posts              Post[]
  emailCampaigns     EmailCampaign[]
  shortVideoProjects ShortVideoProject[]
  AdCreative         AdCreative[]

  @@index([organizationId])
  @@index([brandProfileId])
  @@index([status])
  @@index([contentIdeaId])
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  WAITING_PROVIDER
  COMPLETED
  FAILED
  CANCELLED
  PARTIAL
}

enum GenerationJobType {
  BRAND_DNA_EXTRACTION
  IDEA_GENERATION
  CAROUSEL_PLAN
  IMAGE_GENERATION
  DESIGN_SYSTEM_RENDER
  CAPTION_GENERATION
  BULK_GENERATION
  SOCIAL_POST_GENERATION
  AD_CREATIVE_GENERATION
  EMAIL_GENERATION
  VIDEO_GENERATION
  VIDEO_SCRIPT
}

model GenerationJob {
  id                String              @id @default(uuid())
  organizationId    String
  brandProfileId    String?
  carouselProjectId String?
  type              GenerationJobType
  status            GenerationJobStatus @default(QUEUED)
  progress          Json?
  result            Json?
  error             String?
  model             String?
  provider          String?
  promptVersion     String?
  schemaVersion     String?
  usage             Json?
  costEstimate      Float?
  idempotencyKey    String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  organization      Organization        @relation(fields: [organizationId], references: [id])
  generationCosts   GenerationCost[]
  AdCreative        AdCreative[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
  @@index([carouselProjectId])
  @@index([idempotencyKey])
}

model EditorialPlan {
  id               String    @id @default(uuid())
  brandProfileId   String
  organizationId   String
  name             String
  frequencyPerWeek Int       @default(3)
  platforms        String[]  @default(["instagram"])
  pillars          String[]  @default([])
  objectives       String[]  @default([])
  languages        String[]  @default(["pt-BR"])
  timezone         String    @default("America/Sao_Paulo")
  blackoutDates    String[]  @default([])
  autoGenerate     Boolean   @default(false)
  generationWindow String    @default("02:00-06:00")
  maxCostPerMonth  Float     @default(50)
  lastRunAt        DateTime?
  consecutiveFails Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  brandProfile BrandProfile    @relation(fields: [brandProfileId], references: [id])
  slots        EditorialSlot[]

  @@index([brandProfileId])
  @@index([organizationId])
}

model EditorialSlot {
  id                String              @id @default(uuid())
  editorialPlanId   String
  brandProfileId    String
  organizationId    String
  scheduledDate     DateTime
  pillar            String?
  objective         String?
  platform          String              @default("instagram")
  status            EditorialSlotStatus @default(PLANNED)
  contentIdeaId     String?
  carouselProjectId String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  editorialPlan   EditorialPlan    @relation(fields: [editorialPlanId], references: [id])
  contentIdea     ContentIdea?     @relation(fields: [contentIdeaId], references: [id])
  carouselProject CarouselProject? @relation(fields: [carouselProjectId], references: [id])

  @@index([editorialPlanId])
  @@index([brandProfileId])
  @@index([organizationId])
  @@index([scheduledDate])
  @@index([status])
}

enum EditorialSlotStatus {
  PLANNED
  IDEAS_GENERATED
  APPROVED
  REJECTED
  CAROUSEL_CREATED
  SCHEDULED
  PUBLISHED
}

model CarouselPerformance {
  id                String    @id @default(uuid())
  carouselProjectId String?
  postId            String?
  organizationId    String
  brandProfileId    String
  platform          String
  impressions       Int       @default(0)
  reach             Int       @default(0)
  saves             Int       @default(0)
  shares            Int       @default(0)
  comments          Int       @default(0)
  clicks            Int       @default(0)
  likes             Int       @default(0)
  engagementRate    Float     @default(0)
  reachRate         Float     @default(0)
  normalizedScore   Float     @default(0)
  rawMetrics        Json?
  collectedAt       DateTime  @default(now())
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  carouselProject CarouselProject? @relation(fields: [carouselProjectId], references: [id])

  @@index([carouselProjectId])
  @@index([organizationId])
  @@index([brandProfileId])
  @@index([platform])
  @@index([collectedAt])
}

enum BrandLearningStatus {
  SUGGESTED
  APPROVED
  REJECTED
  APPLIED
}

enum BrandLearningType {
  HOOK
  CTA
  THEME
  STYLE_RULE
  TEMPLATE_PERFORMANCE
  BEST_TIME
  BEST_CHANNEL
}

model BrandLearning {
  id             String              @id @default(uuid())
  brandProfileId String
  organizationId String
  type           BrandLearningType
  title          String
  description    String
  evidence       Json?
  confidence     Float               @default(0)
  status         BrandLearningStatus @default(SUGGESTED)
  appliedAt      DateTime?
  appliedVersion Int?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@index([brandProfileId])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([brandProfileId, status])
}

// ===== Fase 6.7.2: Ad Creative =====

enum AdCreativeType {
  STATIC
  CAROUSEL
}

enum AdObjective {
  AWARENESS
  CONSIDERATION
  CONVERSION
  LEAD_GENERATION
  TRAFFIC
  ENGAGEMENT
}

enum AdPlatform {
  META_FACEBOOK
  META_INSTAGRAM
  LINKEDIN
}

model AdCreative {
  id                String         @id @default(uuid())
  organizationId    String
  brandProfileId    String
  contentIdeaId     String?
  carouselProjectId String?
  type              AdCreativeType
  platform          AdPlatform
  objective         AdObjective
  adTemplateId      String?
  headline          String
  primaryText       String
  description       String?
  ctaButton         String
  destinationUrl    String?
  imageUrl          String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  // Carousel-specific fields
  slides     Json?
  slideCount Int?

  // Ad policy / compliance
  policyWarnings Json?
  claimsFlags    Json?

  // Image references
  mediaAssets Json?

  // Generation tracking
  generationJobId String?
  schemaVersion   String?
  promptVersion   String?

  // Status tracking
  status String @default("DRAFT")

  // Relations
  generationJob   GenerationJob?   @relation(fields: [generationJobId], references: [id])
  contentIdea     ContentIdea?     @relation(fields: [contentIdeaId], references: [id])
  carouselProject CarouselProject? @relation(fields: [carouselProjectId], references: [id])

  organization Organization @relation(fields: [organizationId], references: [id])
  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id])

  @@index([organizationId])
  @@index([brandProfileId])
  @@index([contentIdeaId])
  @@index([carouselProjectId])
  @@index([platform])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ===== Fase 6.7.3: Email Campaign =====

enum EmailCampaignType {
  NEWSLETTER
  WELCOME_SEQUENCE
  PROMOTIONAL
}

enum EmailCampaignStatus {
  DRAFT
  GENERATING
  READY
  EXPORTED
  FAILED
}

model EmailCampaign {
  id                String              @id @default(uuid())
  organizationId    String
  brandProfileId    String
  contentIdeaId     String?
  carouselProjectId String?
  type              EmailCampaignType
  name              String
  status            EmailCampaignStatus @default(DRAFT)
  subject           String
  preheader         String?
  bodyHtml          String
  bodyJson          Json?
  ctaText           String?
  ctaUrl            String?
  ctaColor          String?
  headerImageUrl    String?
  logoUrl           String?
  primaryColor      String?
  secondaryColor    String?
  sequenceIndex     Int?
  sequenceTotal     Int?
  sequenceDelayDays Int?
  generationJobId   String?
  promptVersion     String?
  schemaVersion     String?
  generationMeta    Json?
  model             String?
  provider          String?
  exportCount       Int                 @default(0)
  lastExportedAt    DateTime?
  deletedAt         DateTime?
  metadata          Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id])
  brandProfile      BrandProfile        @relation(fields: [brandProfileId], references: [id])
  contentIdea       ContentIdea?        @relation(fields: [contentIdeaId], references: [id])
  carouselProject   CarouselProject?    @relation(fields: [carouselProjectId], references: [id])

  @@index([organizationId])
  @@index([brandProfileId])
  @@index([contentIdeaId])
  @@index([carouselProjectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([sequenceIndex, sequenceTotal])
}

// ===== Fase 6.7.4: Short Video =====

enum ShortVideoFormat {
  REELS
  TIKTOK
  SHORTS
  STORIES
  CUSTOM
}

enum ShortVideoStatus {
  DRAFT
  SCRIPT_GENERATED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

model ShortVideoProject {
  id                String           @id @default(uuid())
  organizationId    String
  brandProfileId    String
  carouselProjectId String?
  contentIdeaId     String?
  name              String
  format            ShortVideoFormat @default(REELS)
  status            ShortVideoStatus @default(DRAFT)
  aspectRatio       String           @default("9:16")
  maxDurationSec    Int              @default(60)

  // Script/storyboard (JSON)
  script           Json?
  totalDurationSec Float?

  // Render results
  videoUrl       String?
  thumbnailUrl   String?
  renderProvider String?
  renderJobId    String?
  renderResult   Json?

  // Cost tracking
  scriptCostEstimate Float?
  renderCostEstimate Float?
  totalCostEstimate  Float?
  renderCostActual   Float?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  brandProfile    BrandProfile    @relation(fields: [brandProfileId], references: [id])
  carouselProject CarouselProject? @relation(fields: [carouselProjectId], references: [id])
  contentIdea     ContentIdea?    @relation(fields: [contentIdeaId], references: [id])

  @@index([organizationId])
  @@index([brandProfileId])
  @@index([carouselProjectId])
  @@index([status])
}

// ===== Fase 7.3: Affiliate Program =====

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum ReferralStatus {
  CLICKED
  SIGNED_UP
  CONVERTED
  COMMISSION_PAID
  CANCELLED
}

model Affiliate {
  id               String          @id @default(uuid())
  organizationId   String
  code             String          @unique
  name             String
  email            String
  status           AffiliateStatus @default(PENDING)
  commissionRate   Float           @default(0.20)
  totalReferrals   Int             @default(0)
  totalConversions Int             @default(0)
  totalEarnings    Float           @default(0)
  paidEarnings     Float           @default(0)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  referrals    Referral[]

  @@index([organizationId])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
}

model Referral {
  id               String         @id @default(uuid())
  affiliateId      String
  referralCode     String
  visitorIp        String?
  userAgent        String?
  referredOrgId    String?
  status           ReferralStatus @default(CLICKED)
  commissionAmount Float?
  convertedAt      DateTime?
  paidAt           DateTime?
  metadata         Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([referralCode])
  @@index([status])
  @@index([referredOrgId])
  @@index([createdAt])
}

// ===== Fase 8.2: Template Marketplace =====

enum TemplateSource {
  OFFICIAL
  COMMUNITY
  PRIVATE
}

enum TemplateStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

model MarketplaceTemplate {
  id              String         @id @default(uuid())
  creatorOrgId    String?
  name            String
  description     String
  category        String
  source          TemplateSource @default(COMMUNITY)
  status          TemplateStatus @default(DRAFT)
  version         Int            @default(1)
  templateData    Json
  previewImageUrl String?
  tags            String[]
  usageCount      Int            @default(0)
  installCount    Int            @default(0)
  rating          Float          @default(0)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  installations TemplateInstallation[]

  @@index([source])
  @@index([status])
  @@index([category])
  @@index([creatorOrgId])
  @@index([deletedAt])
}

model TemplateInstallation {
  id               String   @id @default(uuid())
  organizationId   String
  templateId       String
  installedVersion Int
  active           Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  template MarketplaceTemplate @relation(fields: [templateId], references: [id])

  @@unique([organizationId, templateId])
  @@index([organizationId])
  @@index([templateId])
}

// ===== Fase 8.3: Webhooks and Integrations =====

enum WebhookStatus {
  ACTIVE
  PAUSED
  FAILED
  DELETED
}

model Webhook {
  id                 String        @id @default(uuid())
  organizationId     String
  url                String
  events             String[]
  secret             String
  status             WebhookStatus @default(ACTIVE)
  failureCount       Int           @default(0)
  lastTriggeredAt    DateTime?
  lastResponseStatus Int?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  deliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([status])
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  webhookId      String
  event          String
  payload        Json
  responseStatus Int?
  responseBody   String?
  success        Boolean  @default(false)
  attemptCount   Int      @default(1)
  createdAt      DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id])

  @@index([webhookId])
  @@index([createdAt])
}

model GenerationCost {
  id              String   @id @default(uuid())
  organizationId  String
  generationJobId String?
  type            String // 'text' | 'image' | 'estimate'
  label           String
  costUsd         Float
  costBrl         Float
  usdToBrl        Float
  tokens          Json // NormalizedUsage
  provider        String?
  model           String?
  createdAt       DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id])
  generationJob GenerationJob? @relation(fields: [generationJobId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@index([type])
}

model CarouselDraft {
  id             String   @id @default(uuid())
  organizationId String
  brandProfileId String?
  status         String   @default("draft") // draft | completed
  data           Json // Full state: plan, ideas, review, caption, slideImages refs
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([updatedAt])
}
