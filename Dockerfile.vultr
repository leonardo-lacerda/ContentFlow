FROM node:22.20-bookworm-slim

ARG NEXT_PUBLIC_VERSION=1.47.0
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make python3 bash nginx curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app
COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf
RUN chmod +x /app/var/docker/start-vultr.sh \
 && mkdir -p /uploads && chmod 777 /uploads

RUN pnpm install --frozen-lockfile || pnpm install

# Ensure SWC baseUrl is absolute (fixes nest/swc panic)
RUN node -e "const fs=require('fs'); const p='.swcrc'; const j=JSON.parse(fs.readFileSync(p,'utf8')); j.jsc=j.jsc||{}; j.jsc.baseUrl='/app'; fs.writeFileSync(p, JSON.stringify(j,null,2)); fs.copyFileSync(p,'apps/backend/.swcrc'); console.log('swcrc ok', j.jsc.baseUrl);"

RUN pnpm run prisma-generate || true

# Build from monorepo root so path aliases resolve
WORKDIR /app
RUN NODE_OPTIONS="--max-old-space-size=3072" pnpm --filter ./apps/backend exec nest build \
 || NODE_OPTIONS="--max-old-space-size=3072" sh -c 'cd apps/backend && nest build' \
 || NODE_OPTIONS="--max-old-space-size=3072" pnpm run build:backend

WORKDIR /app
RUN NODE_OPTIONS="--max-old-space-size=3072" pnpm run build:frontend

EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=8 \
  CMD curl -sf http://localhost:5000/ || exit 1
CMD ["bash", "/app/var/docker/start-vultr.sh"]
