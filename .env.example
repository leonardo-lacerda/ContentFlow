# IA Generate integration
AI_GENERATE_BASE_URL="http://localhost:4400"
AI_GENERATE_API_KEY=""
AI_GENERATE_IMAGE_MODEL="gpt-image/1.5-text-to-image"
AI_GENERATE_IMAGE_SIZE="1024x1024"
AI_GENERATE_IMAGE_RESPONSE_FORMAT="b64_json"
AI_GENERATE_TIMEOUT_MS="120000"
# Inspiration pipeline (OpenAI official): one VISION model reads/describes the
# selected inspiration images, another IMAGE model generates from prompt + brief.
# Vision model that extracts the visual brief from the inspirations:
AI_GENERATE_OPENAI_REFERENCE_DESCRIPTION_MODEL="gpt-4.1-mini"
AI_GENERATE_OPENAI_REFERENCE_DESCRIPTION_FALLBACK_MODEL="gpt-4o-mini"
# Image model used to generate when inspirations are selected:
AI_GENERATE_OPENAI_IMAGE_MODEL_WITH_REFERENCES="gpt-image-2"
# Image model used when no inspirations are selected:
AI_GENERATE_OPENAI_IMAGE_MODEL="gpt-image-2"
# How long (ms) to reuse the inspiration brief so the same carousel does not
# re-describe identical images for every slide. Default: 10 minutes.
AI_GENERATE_REFERENCE_BRIEF_TTL_MS="600000"

NEXT_PUBLIC_DISCORD_SUPPORT=""
NEXT_PUBLIC_POLOTNO=""
# NOT_SECURED=false
API_LIMIT=30 # The limit of the public API hour limit

